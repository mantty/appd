{
  "name": "appd",
  "private": true,
  "files": [],
  "packageManager": "pnpm@9.9.0",
  "type": "module",
  "scripts": {
    "build:runtime": "tsc --project runtime/tsconfig.build.json",
    "lint:ts": "eslint runtime plugins --max-warnings 0 && tsc --project runtime/tsconfig.json && tsc --project plugins/tsconfig.json",
    "test:bare": "pnpm build:runtime && bare runtime/tests/response.bare.mjs && bare runtime/tests/crypto.bare.mjs && bare runtime/tests/ipc.bare.mjs",
    "test:ts": "node --import tsx --test runtime/tests/**/*.test.ts plugins/**/*.test.ts"
  },
  "dependencies": {
    "bare-abort-controller": "^1.0.1",
    "bare-buffer": "^3.0.2",
    "bare-crypto": "^1.2.8",
    "bare-encoding": "^1.0.3",
    "bare-events": "^2.6.0",
    "bare-fetch": "^3.0.1",
    "bare-fs": "^4.7.3",
    "bare-http1": "^4.5.7",
    "bare-https": "^3.0.0",
    "bare-process": "^4.5.1",
    "bare-stream": "^2.10.0",
    "bare-tcp": "^2.5.2",
    "bare-tls": "file:vendor/bare-tls",
    "bare-url": "^2.4.0",
    "bare-ws": "file:vendor/bare-ws"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@types/node": "^22.19.15",
    "bare": "1.29.4",
    "bare-bundle": "^1.10.0",
    "bare-console": "^6.2.0",
    "bare-ipc": "^1.1.0",
    "bare-logger": "^2.0.0",
    "bare-make": "^1.8.0",
    "bare-module": "^6.0.1",
    "bare-module-resolve": "^1.12.2",
    "bare-path": "^3.1.1",
    "bare-system-logger": "^1.0.1",
    "bare-unpack": "^1.0.2",
    "cmake-bare": "^1.3.0",
    "cmake-bare-bundle": "^2.1.3",
    "cmake-fetch": "^1.1.0",
    "cmake-java": "^0.1.2",
    "cmake-napi": "^1.1.2",
    "cmake-npm": "^1.1.0",
    "eslint": "^9.39.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.53.1"
  },
  "pnpm": {
    "overrides": {
      "cmake-toolchains": "file:vendor/cmake-toolchains",
      "bare-tls": "file:vendor/bare-tls",
      "bare-ws": "file:vendor/bare-ws"
    }
  }
}
