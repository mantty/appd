{
  "schemaVersion": 1,
  "id": "geolocation",
  "kind": "frontend",
  "platforms": {
    "macos": {
      "class": "AppdGeolocationPlugin",
      "sources": ["apple/GeolocationPlugin.swift"],
      "frameworks": ["CoreLocation"],
      "plist": {
        "NSLocationUsageDescription": "This app uses your location when you request location features."
      }
    },
    "ios": {
      "class": "AppdGeolocationPlugin",
      "sources": ["apple/GeolocationPlugin.swift"],
      "frameworks": ["CoreLocation"],
      "plist": {
        "NSLocationWhenInUseUsageDescription": "This app uses your location when you request location features."
      }
    },
    "ios-simulator": {
      "class": "AppdGeolocationPlugin",
      "sources": ["apple/GeolocationPlugin.swift"],
      "frameworks": ["CoreLocation"],
      "plist": {
        "NSLocationWhenInUseUsageDescription": "This app uses your location when you request location features."
      }
    },
    "android": {
      "class": "com.appd.plugins.geolocation.AppdGeolocationPlugin",
      "sources": ["android/GeolocationPlugin.kt"],
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    }
  }
}
