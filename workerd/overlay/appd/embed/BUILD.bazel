load("@rules_cc//cc:cc_library.bzl", "cc_library")

# This package sits outside workerd's tree and cannot load its internal
# wd_cc_library macro.
cc_library(
    name = "appd-workerd",
    srcs = ["appd_workerd.cpp"],
    hdrs = ["appd_workerd.h"],
    # server.h quote-includes same-package siblings; add its directory to
    # the quote search path.
    copts = ["-iquote", "src/workerd/server"],
    strip_include_prefix = "/appd/embed",
    visibility = ["//visibility:public"],
    deps = [
        "//src/workerd/server:cpp-capnp-schema",
        "//src/workerd/server:server",
        "//src/workerd/server:v8-platform-impl",
        "//src/workerd/server:workerd-capnp-schema",
        "//src/workerd/server:workerd_capnp",
        "//src/workerd/jsg",
        "//src/workerd/util:autogate",
        "//src/workerd/util:entropy",
        "@capnp-cpp//src/capnp:capnpc",
        "@capnp-cpp//src/kj",
        "@capnp-cpp//src/kj:kj-async",
    ],
)
