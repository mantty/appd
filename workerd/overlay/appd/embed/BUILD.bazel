load("@rules_cc//cc:cc_library.bzl", "cc_library")

# Plain native cc_library (not workerd's own wd_cc_library) -- this package
# lives outside workerd's own source tree, so it can't load workerd's
# build-internal macros the way upstream packages do.
cc_library(
    name = "appd-workerd",
    srcs = ["appd_workerd.cpp"],
    hdrs = ["appd_workerd.h"],
    # server.h quote-includes "channel-token.h" assuming a same-directory
    # sibling, which only resolves for in-package consumers; add the real
    # package dir as a quote-search path since we're the first cross-package
    # consumer of :server's headers.
    copts = ["-iquote", "src/workerd/server"],
    strip_include_prefix = "/appd/embed",
    visibility = ["//visibility:public"],
    deps = [
        "//src/workerd/server:cpp-capnp-schema",
        "//src/workerd/server:server",
        "//src/workerd/server:v8-platform-impl",
        "//src/workerd/server:workerd-capnp-schema",
        "//src/workerd/server:workerd_capnp",
        "//src/workerd/jsg",
        "//src/workerd/util:autogate",
        "//src/workerd/util:entropy",
        "@capnp-cpp//src/capnp:capnpc",
        "@capnp-cpp//src/kj",
        "@capnp-cpp//src/kj:kj-async",
    ],
)
